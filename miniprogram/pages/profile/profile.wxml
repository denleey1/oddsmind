<!--pages/profile/profile.wxml-->
<view class="profile-page">
  <!-- 用户信息区域 -->
  <view class="user-header gradient-bg">
    <view class="user-avatar">
      <text class="avatar-text">👤</text>
    </view>
    <view class="user-info">
      <text class="user-name">{{userInfo.nickname || userInfo.openid || 'OddsMind 用户'}}</text>
      <text class="user-desc">
        {{userInfo.openid ? '微信登录ID：' + userInfo.openid : '使用微信登录自动进入'}}
      </text>
      <view class="status-badge-wrapper">
        <text class="status-badge {{isActivated ? 'activated' : 'not-activated'}}">
          {{isActivated ? '✓ 已激活' : '✗ 未激活'}}
        </text>
      </view>
    </view>
  </view>

  <!-- 账号信息 -->
  <view class="info-section" wx:if="{{userInfo.openid}}">
    <view class="info-item">
      <text class="info-label">账号状态</text>
      <text class="info-value {{isActivated ? 'activated' : 'not-activated'}}">
        {{isActivated ? '已激活' : '未激活'}}
      </text>
    </view>
    <view class="info-item clickable" wx:if="{{expiresAt}}" bindtap="showExpiresDetail">
      <view class="info-left">
        <text class="info-label">过期时间</text>
        <text class="info-value expires-time">{{formatExpiresAt(expiresAt)}}</text>
      </view>
      <view class="info-right">
        <text class="info-hint">点击查看</text>
        <text class="info-arrow">></text>
      </view>
    </view>
    <view class="info-item clickable" wx:else bindtap="refreshUserInfo">
      <view class="info-left">
        <text class="info-label">过期时间</text>
        <text class="info-value">永久有效</text>
      </view>
      <view class="info-right">
        <text class="info-hint">点击刷新</text>
        <text class="info-arrow">></text>
      </view>
    </view>
    <view class="info-item">
      <text class="info-label">OpenID</text>
      <text class="info-value openid">{{userInfo.openid}}</text>
    </view>
  </view>

  <!-- 会员卡片 -->
  <view class="vip-card">
    <view class="vip-content">
      <view class="vip-icon">👑</view>
      <view class="vip-text">
        <text class="vip-title">{{isActivated ? '会员' : '未开通'}}</text>
        <text class="vip-subtitle">{{isActivated ? '到期时间: ' + expiresAt : '请联系管理员获取激活码'}}</text>
      </view>
    </view>
  </view>

  <!-- 续费输入区域 -->
  <view class="renew-section" wx:if="{{isActivated}}">
    <view class="renew-card">
      <view class="renew-title">输入激活码续费</view>
      <view class="renew-input-group">
        <input
          class="renew-input"
          type="text"
          placeholder="请输入激活码"
          value="{{renewCode}}"
          bindinput="onRenewCodeInput"
          maxlength="20"
        />
        <button class="renew-btn" bindtap="onSubmitRenew" disabled="{{renewLoading}}" loading="{{renewLoading}}">
          {{renewLoading ? '续费中...' : '续费'}}
        </button>
      </view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="section-title" bindtap="toggleModule" data-module="menu">
      <text>功能菜单</text>
      <text class="module-toggle {{collapsedModules.menu ? '' : 'expanded'}}">▼</text>
    </view>
    
    <view class="menu-list" wx:if="{{!collapsedModules.menu}}">
      <view class="menu-item" bindtap="navigateToMatches">
        <view class="menu-left">
          <text class="menu-icon">📅</text>
          <text class="menu-text">全部比赛</text>
        </view>
        <text class="menu-arrow">></text>
      </view>

      <view class="menu-item" bindtap="showFinishedMatches">
        <view class="menu-left">
          <text class="menu-icon">📊</text>
          <text class="menu-text">已完成比赛</text>
        </view>
        <text class="menu-arrow">></text>
      </view>

      <!-- 产品说明和使用方法已移除外部链接 -->

      <view class="menu-item" bindtap="checkUpdate">
        <view class="menu-left">
          <text class="menu-icon">🔄</text>
          <text class="menu-text">检查更新</text>
        </view>
        <text class="menu-arrow">></text>
      </view>
    </view>
  </view>

  <!-- 系统设置 -->
  <view class="menu-section">
    <view class="section-title" bindtap="toggleModule" data-module="system">
      <text>系统设置</text>
      <text class="module-toggle {{collapsedModules.system ? '' : 'expanded'}}">▼</text>
    </view>
    
    <view class="menu-list" wx:if="{{!collapsedModules.system}}">
      <view class="menu-item" wx:if="{{expiresAt}}">
        <view class="menu-left">
          <text class="menu-icon">⏰</text>
          <text class="menu-text">续费提醒</text>
        </view>
        <switch checked="{{expirationReminderEnabled}}" bindchange="toggleExpirationReminder" color="#FF6B35" />
      </view>

      <view class="menu-item" bindtap="clearCache">
        <view class="menu-left">
          <text class="menu-icon">🗑️</text>
          <text class="menu-text">清除缓存</text>
        </view>
        <text class="menu-arrow">></text>
      </view>

      <view class="menu-item" bindtap="showAbout">
        <view class="menu-left">
          <text class="menu-icon">ℹ️</text>
          <text class="menu-text">关于我们</text>
        </view>
        <text class="menu-arrow">></text>
      </view>

      <view class="menu-item" bindtap="contactUs">
        <view class="menu-left">
          <text class="menu-icon">📞</text>
          <text class="menu-text">联系客服</text>
        </view>
        <text class="menu-arrow">></text>
      </view>
    </view>
  </view>

  <!-- 版本信息 -->
  <view class="version-info">
    <text class="version-text">OddsMind v{{version}}</text>
    <text class="copyright-text">专业足球赔率分析</text>
  </view>

  <view class="logout-wrapper">
    <button class="logout-button" bindtap="logout">退出登录</button>
  </view>
</view>


