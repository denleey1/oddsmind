/* pages/index/index.wxss */
.index-page {
  min-height: 100vh;
  background: var(--bg-secondary);
  padding-bottom: calc(var(--spacing-3xl) + env(safe-area-inset-bottom));
}

/* 头部横幅 */
.header-banner {
  padding: 72rpx var(--spacing-2xl) 56rpx;
  background: linear-gradient(135deg, #FF6B35 0%, #FF8C61 100%);
  border-radius: 0 0 60rpx 60rpx;
  box-shadow: var(--shadow-primary);
}

.banner-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.banner-title {
  font-size: 46rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin-bottom: 10rpx;
  line-height: 1.25;
  text-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
}

.banner-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  letter-spacing: 1.5rpx;
  line-height: 1.4;
}

/* 快捷操作 */
.quick-actions {
  display: flex;
  justify-content: space-around;
  align-items: center;
  margin: -42rpx var(--spacing-2xl) var(--spacing-xl);
  padding: 28rpx 20rpx;
  background: var(--bg-primary);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  min-height: 120rpx;
  padding: 12rpx 10rpx;
  justify-content: center;
  transition: transform 0.3s ease;
}

.action-item:active {
  transform: scale(0.95);
}

.action-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #F8F9FA;
  border: 1rpx solid #F1F3F5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  box-shadow: var(--shadow-xs);
}

.action-text {
  font-size: 22rpx;
  color: var(--text-primary);
  font-weight: 500;
  line-height: 1.3;
}

/* 数据统计 */
.stats-container {
  display: flex;
  justify-content: space-around;
  align-items: center;
  margin: 0 var(--spacing-2xl) var(--spacing-xl);
  padding: 28rpx 20rpx;
  background: var(--bg-primary);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  min-height: 98rpx;
  justify-content: center;
}

.stat-value {
  font-size: 44rpx;
  font-weight: bold;
  color: var(--primary-color);
  font-family: 'DIN Alternate', 'Arial', sans-serif;
  line-height: 1.1;
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.35;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: var(--border-color);
}

/* 区域 */
.section {
  margin: 0 var(--spacing-2xl) var(--spacing-xl);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-lg);
  min-height: 64rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-primary);
  line-height: 1.35;
}

.section-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.module-toggle {
  font-size: 24rpx;
  color: var(--text-tertiary);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  padding: 10rpx;
}

.module-toggle.expanded {
  transform: rotate(180deg);
  color: var(--primary-color);
}

.section-more {
  font-size: 24rpx;
  color: var(--text-secondary);
  padding: 10rpx 14rpx;
  border-radius: 12rpx;
  transition: all 0.3s ease;
  line-height: 1.2;
}

.section-more:active {
  background: var(--bg-secondary);
  color: var(--primary-color);
}

/* 比赛容器 */
.matches-container {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-lg);
}

/* 加载状态 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 72rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--border-color);
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  margin-top: var(--spacing-lg);
  color: var(--text-secondary);
  font-size: 24rpx;
}


