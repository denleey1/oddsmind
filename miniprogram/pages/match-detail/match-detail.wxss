  transition: transform 0.3s ease;
  display: inline-block;
  margin-left: 4rpx;
}

.fundamental-range-toggle.expanded {
  transform: rotate(180deg);
}

.odds-grid {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.odds-column {
  flex: 1;
  min-width: 240rpx;
}

.odds-section-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.odds-row {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.odds-value-block {
  flex: 1;
  padding: 12rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  text-align: center;
}

.strength-row {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
  border-top: 1rpx solid var(--border-color);
  padding-top: 16rpx;
}

.strength-item {
  flex: 1;
  text-align: center;
}

.strength-label {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.strength-value {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--primary-color);
}

.company-selector {
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 8rpx;
  background: #F3F4F6;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 26rpx;
  color: #374151;
  font-weight: 500;
  border: 1rpx solid #E5E7EB;
}

.selector-icon {
  font-size: 24rpx;
  color: #9CA3AF;
}

.summary-row {
  display: flex;
  gap: 12rpx;
  justify-content: space-between;
  flex-wrap: wrap;
}

.summary-card {
  flex: 1;
  min-width: 180rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #f7f7f7;
  text-align: center;
}

.summary-label {
  font-size: 20rpx;
  color: var(--text-secondary);
}

.summary-value {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--primary-color);
  margin-top: 6rpx;
}

.summary-meta {
  font-size: 20rpx;
  color: var(--accent-color);
}

.poisson-grid {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.poisson-item {
  flex: 1;
  min-width: 180rpx;
  padding: 16rpx;
  background: #f5f5f5;
  border-radius: 14rpx;
  text-align: center;
}

.poisson-label {
  color: var(--text-secondary);
  font-size: 20rpx;
}

.poisson-value {
  font-size: 30rpx;
  font-weight: 700;
  margin-top: 6rpx;
}

/* ========== 公司态度汇总模块样式 ========== */
.attitude-card .total-badge {
  font-size: 20rpx;
  font-weight: 600;
  color: #E8590C;
  background: #FEF3C7;
  padding: 4rpx 10rpx;
  border-radius: 4rpx;
  margin-left: 12rpx;
}

.attitude-content {
  margin-top: 16rpx;
}

/* 态度切换标签 */
.attitude-tabs {
  display: flex;
  background: #F3F4F6;
  border-radius: 8rpx;
  padding: 4rpx;
  margin-bottom: 20rpx;
}

.attitude-tab {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 24rpx;
  color: #6B7280;
  border-radius: 6rpx;
  transition: all 0.2s ease;
  font-weight: 500;
}

.attitude-tab.active {
  background: #1F2937;
  color: #FFFFFF;
  font-weight: 600;
}

/* 态度项 */
.attitude-item {
  padding: 14rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}

.attitude-item:last-of-type {
  border-bottom: none;
}

.attitude-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.attitude-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #374151;
}

.attitude-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 3rpx;
}

.attitude-stats {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.attitude-count {
  font-size: 22rpx;
  color: #9CA3AF;
}

.attitude-percent {
  font-size: 28rpx;
  font-weight: 700;
  color: #1F2937;
  min-width: 70rpx;
  text-align: right;
  font-family: 'DIN Condensed', 'Impact', sans-serif;
}

.expand-icon {
  font-size: 18rpx;
  color: #D1D5DB;
  transition: transform 0.2s ease;
}

.expand-icon.expanded {
  transform: rotate(180deg);
  color: #E8590C;
}

/* 进度条 */
.attitude-bar-container {
  height: 8rpx;
  background: #E5E7EB;
  border-radius: 4rpx;
  overflow: hidden;
}

.attitude-bar {
  height: 100%;
  border-radius: 4rpx;
  transition: width 0.4s ease;
}

.attitude-bar.home {
  background: #E8590C;
}

.attitude-bar.draw {
  background: #F59E0B;
}

.attitude-bar.away {
  background: #3B82F6;
}

/* 公司标签列表 */
.attitude-companies {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  max-height: 300rpx;
  overflow-y: auto;
  padding: 12rpx;
  background: #f9f9f9;
  border-radius: 10rpx;
}

.company-tag {
  font-size: 22rpx;
  color: var(--text-secondary);
  background: #ffffff;
  padding: 6rpx 14rpx;
  border-radius: 16rpx;
  border: 1rpx solid #e8e8e8;
  white-space: nowrap;
}

/* 饼图区域 */
.attitude-pie-section {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
}

.pie-chart-wrapper {
  flex-shrink: 0;
}

.pie-chart {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  position: relative;
  background: conic-gradient(
    #FF6B35 0deg calc(var(--home-pct, 0) * 3.6deg),
    #F7B731 calc(var(--home-pct, 0) * 3.6deg) calc((var(--home-pct, 0) + var(--draw-pct, 0)) * 3.6deg),
    #004E89 calc((var(--home-pct, 0) + var(--draw-pct, 0)) * 3.6deg) 360deg
  );
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 使用伪元素创建饼图效果 */
.pie-slice {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.pie-slice.home {
  background: conic-gradient(
    #FF6B35 0deg,
    #FF6B35 calc(var(--percentage) * 3.6deg),
    transparent calc(var(--percentage) * 3.6deg)
  );
}

.pie-slice.draw {
  background: conic-gradient(
    transparent 0deg,
    transparent calc(var(--start) * 3.6deg),
    #F7B731 calc(var(--start) * 3.6deg),
    #F7B731 calc((var(--start) + var(--percentage)) * 3.6deg),
    transparent calc((var(--start) + var(--percentage)) * 3.6deg)
  );
}

.pie-slice.away {
  background: conic-gradient(
    transparent 0deg,
    transparent calc(var(--start) * 3.6deg),
    #004E89 calc(var(--start) * 3.6deg),
    #004E89 360deg
  );
}

.pie-center {
  position: absolute;
  width: 110rpx;
  height: 110rpx;
  background: #ffffff;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
  z-index: 10;
}

.pie-total {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.2;
}

.pie-label {
  font-size: 18rpx;
  color: var(--text-secondary);
}

/* 图例 */
.pie-legend {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #4B5563;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 3rpx;
}

.legend-dot.home {
  background: #E8590C;
}

.legend-dot.draw {
  background: #F59E0B;
}

.legend-dot.away {
  background: #3B82F6;
}

/* 规则匹配模块 */
.rule-match-card {
  border-left-color: #F59E0B;
}

.teams-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #F9FAFB;
  border-radius: 12rpx;
  padding: 16rpx;
