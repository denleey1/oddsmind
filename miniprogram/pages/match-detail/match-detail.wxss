  padding: 8rpx;
}

.module-toggle.expanded {
  transform: rotate(180deg);
  color: #E8590C;
}

.card-content {
  transition: all 0.3s ease;
}

.system-label {
  font-size: 22rpx;
  font-weight: 400;
  color: #9CA3AF;
  margin-left: 8rpx;
