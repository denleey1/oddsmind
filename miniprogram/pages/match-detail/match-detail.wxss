  flex-direction: column;
  gap: 2rpx;
  align-items: center;
  justify-content: center;
}

.reasonable-odds-table .odds-item {
  font-size: 20rpx;
  line-height: 1.3;
  white-space: nowrap;
}

/* 赔率升降标识 */
.odds-up {
  color: #DC2626;
  font-weight: 700;
  margin-left: 4rpx;
}

.odds-down {
  color: #059669;
  font-weight: 700;
  margin-left: 4rpx;
}

.info-row {
