}

.fundamental-range-header {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
  cursor: pointer;
}

.fundamental-range-label {
  font-weight: 500;
  color: var(--text-secondary);
  flex-shrink: 0;
}

.fundamental-range-content {
  flex: 1;
  min-width: 0;
}

.fundamental-range-preview,
.fundamental-range-expanded {
