}

.prediction-box.green {
  background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
  color: #ffffff;
}

.prediction-box.pink {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  color: #ffffff;
}

.prediction-box.draw {
  background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 100%);
