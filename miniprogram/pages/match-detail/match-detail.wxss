}

.reasonable-odds-row:last-child {
  border-bottom: none;
}

.reasonable-odds-table .table-cell {
  text-align: center;
  word-break: break-all;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
}

.reasonable-odds-table .section-label {
  font-size: 22rpx;
  color: #1F2937;
  font-weight: 600;
}

.reasonable-odds-table .zone-desc {
  font-size: 18rpx;
  color: #9CA3AF;
  font-weight: 400;
}

.reasonable-odds-table .odds-range-cell,
.reasonable-odds-table .company-odds-cell {
