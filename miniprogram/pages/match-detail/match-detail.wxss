  background: #1f3550;
}

.prediction-box {
  border-radius: var(--radius-lg);
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.08);
}

.rules-list {
  gap: 10rpx;
}

.rule-item {
  border-radius: var(--radius-md);
}

.attitude-item {
  padding: 16rpx 0;
}

.attitude-tabs {
  border-radius: var(--radius-md);
}

.attitude-tab {
  border-radius: var(--radius-sm);
}

.attitude-companies {
  border-radius: var(--radius-md);
  background: #fafbfd;
}

.modal-card {
  border-radius: 28rpx 28rpx 0 0;
}

.modal-head {
  padding-bottom: 14rpx;
}

.modal-title {
  line-height: 1.35;
}

/* 临场基本面分析 */
.pull-direction-bar {
  display: flex; align-items: center; gap: 16rpx;
  padding: 20rpx 24rpx; border-radius: 12rpx; margin-bottom: 20rpx;
  border-left: 6rpx solid #94a3b8;
  background: rgba(100,116,139,0.08);
}
.pull-direction-bar.pull-home { border-color: #10b981; background: rgba(16,185,129,0.08); }
.pull-direction-bar.pull-away { border-color: #ef4444; background: rgba(239,68,68,0.08); }
.pull-direction-bar.pull-draw { border-color: #f59e0b; background: rgba(245,158,11,0.08); }
.pull-icon { font-size: 32rpx; font-weight: 800; min-width: 80rpx; text-align: center; }
.pull-home .pull-icon { color: #059669; }
.pull-away .pull-icon { color: #dc2626; }
.pull-draw .pull-icon { color: #d97706; }
.pull-text { flex: 1; }
.pull-label { font-size: 28rpx; font-weight: 700; color: #1e293b; display: block; }
.pull-sub { font-size: 22rpx; color: #94a3b8; margin-top: 4rpx; display: block; }

.distribution-node-bar {
  display: flex;
  align-items: center;
  background: rgba(99,102,241,0.07);
  border-left: 6rpx solid #6366f1;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 16rpx;
}
.distribution-node-label { font-size: 24rpx; color: #64748b; flex-shrink: 0; }
.distribution-node-value { font-size: 28rpx; font-weight: 700; color: #4f46e5; margin-left: 8rpx; }

.prompts-container { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 20rpx; }
.prompt-tag {
  padding: 6rpx 16rpx; border-radius: 8rpx; font-size: 24rpx; font-weight: 500;
  background: rgba(100,116,139,0.1); color: #64748b; border: 1rpx solid rgba(100,116,139,0.15);
}

.absent-section { margin-top: 16rpx; }
.absent-title { font-size: 28rpx; font-weight: 700; color: #1e293b; display: block; margin-bottom: 12rpx; }
.absent-grid { display: flex; gap: 16rpx; }
.absent-col { flex: 1; background: rgba(239,68,68,0.04); border-radius: 12rpx; padding: 16rpx; }
.absent-team-name { font-size: 24rpx; font-weight: 600; color: #ef4444; display: block; margin-bottom: 8rpx; }
.absent-item { font-size: 24rpx; color: #64748b; display: block; padding: 4rpx 0; border-bottom: 1rpx solid rgba(0,0,0,0.04); }
.absent-empty { font-size: 24rpx; color: #94a3b8; display: block; }

.briefing-section { margin-top: 20rpx; background: rgba(59,130,246,0.04); border-radius: 12rpx; padding: 20rpx; }
.briefing-title { font-size: 28rpx; font-weight: 700; color: #1e293b; display: block; margin-bottom: 8rpx; }
.briefing-text { font-size: 26rpx; color: #475569; line-height: 1.7; display: block; }

/* Asian Handicap Card */
.asian-handicap-card {
  background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx;
  border: 2rpx solid rgba(234,179,8,0.25);
  background: linear-gradient(135deg, rgba(234,179,8,0.03) 0%, rgba(245,158,11,0.05) 100%);
}
.ah-table { margin-top: 16rpx; }
.ah-header {
  display: flex; padding: 12rpx 0; border-bottom: 2rpx solid rgba(0,0,0,0.08);
  font-size: 22rpx; color: #94a3b8; font-weight: 600;
}
.ah-row {
  display: flex; padding: 14rpx 0; border-bottom: 1rpx solid rgba(0,0,0,0.04);
  font-size: 26rpx; color: #1e293b; align-items: center;
}
.ah-cell { flex: 1; text-align: center; }
.ah-label-cell { flex: 1.2; text-align: left; font-weight: 600; }
.ah-text-cell { font-weight: 700; }
.ah-theory { background: rgba(59,130,246,0.06); border-radius: 8rpx; }
.ah-theory .ah-text-cell { color: #2563eb; }
.ah-match .ah-text-cell { color: #16a34a; }
.ah-close .ah-text-cell { color: #d97706; }
.ah-diff .ah-text-cell { color: #dc2626; }
.ah-legend {
  display: flex; gap: 16rpx; margin-top: 12rpx; justify-content: flex-end;
  font-size: 20rpx; color: #94a3b8;
}
.ah-legend-item { display: flex; align-items: center; gap: 4rpx; }
.ah-legend-item::before { content: ''; width: 12rpx; height: 12rpx; border-radius: 50%; display: inline-block; }
.ah-match-dot::before { background: #16a34a; }
.ah-close-dot::before { background: #d97706; }
.ah-diff-dot::before { background: #dc2626; }

/* ====== 长节点控赔分析卡片 ====== */
.draw-system-card {
  margin: 16rpx 24rpx; padding: 0;
  background: #fff; border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  overflow: hidden;
  border-left: 6rpx solid #7c3aed;
}
.draw-system-card .card-title {
  padding: 20rpx 24rpx;
  display: flex; align-items: center;
  font-size: 28rpx; font-weight: 700; color: #1e293b;
}
.draw-system-card .system-label {
  font-size: 22rpx; color: #7c3aed; margin-left: 8rpx; font-weight: 500;
}
.draw-system-body {
  padding: 0 24rpx 24rpx;
}
.ds-section {
  margin-bottom: 20rpx;
  padding: 16rpx;
  background: #fafaff;
  border-radius: 12rpx;
  border: 1rpx solid rgba(124,58,237,0.08);
}
.ds-section:last-child { margin-bottom: 0; }
.ds-section-title {
  display: flex; align-items: center;
  font-size: 24rpx; font-weight: 600; color: #334155;
  margin-bottom: 12rpx;
}
.ds-dot {
  width: 14rpx; height: 14rpx; border-radius: 50%;
  margin-right: 10rpx; flex-shrink: 0;
}
.ds-dot.long-node { background: #7c3aed; }
.ds-dot.control-node { background: #f59e0b; }
.ds-dot.current-node { background: #059669; }
.ds-dot.deviation-node { background: #3b82f6; }
.ds-source-tag {
  margin-left: auto;
  font-size: 20rpx; font-weight: 500;
  color: #fff; background: #7c3aed;
  padding: 2rpx 12rpx; border-radius: 6rpx;
}
.ds-tag-current { background: #059669; }
.ds-odds-row {
  display: flex; gap: 12rpx; margin-bottom: 8rpx;
}
.ds-odds-item {
  flex: 1; display: flex; flex-direction: column; align-items: center;
  padding: 8rpx 0;
  background: #fff; border-radius: 8rpx;
  border: 1rpx solid rgba(124,58,237,0.1);
}
.ds-odds-value {
  font-size: 30rpx; font-weight: 700; color: #1e293b;
}
.ds-odds-value.highlight {
  color: #7c3aed;
}
.ds-meta-row {
  display: flex; gap: 16rpx; flex-wrap: wrap;
}
.ds-section-deviation {
  background: #fff;
  border: 1rpx solid #e2e8f0;
}
.ds-deviation-grid {
  display: flex; gap: 10rpx; margin-bottom: 12rpx;
}
.ds-deviation-item {
  flex: 1; display: flex; flex-direction: column; align-items: center;
  padding: 10rpx 4rpx;
  background: #fff; border-radius: 8rpx;
}
.ds-deviation-cell {
  background: #f8fafc; border-radius: 10rpx; padding: 14rpx 6rpx;
}
.ds-deviation-label {
  font-size: 22rpx; color: #64748b; margin-bottom: 6rpx;
}
.ds-deviation-value {
  font-size: 28rpx; font-weight: 700; color: #1e293b;
}
.ds-value-purple { color: #7c3aed; }
.ds-deviation-value.deviation-high { color: #dc2626; font-size: 30rpx; font-weight: 800; }
.ds-deviation-value.deviation-low { color: #16a34a; font-size: 30rpx; font-weight: 800; }
.ds-deviation-value.deviation-ok { color: #475569; }
.ds-conclusion {
  margin-top: 10rpx; padding: 14rpx 16rpx;
  border-radius: 10rpx;
  font-size: 26rpx; font-weight: 700; text-align: center;
}
.ds-conclusion.deviation-high {
  background: #fef2f2;
  color: #dc2626;
  border: 1rpx solid #fecaca;
}
.ds-conclusion.deviation-low {
  background: #f0fdf4;
  color: #15803d;
  border: 1rpx solid #bbf7d0;
}
.ds-conclusion.deviation-ok {
  background: #f8fafc;
  color: #475569;
  border: 1rpx solid #e2e8f0;
}
.ds-section-current {
  border: 1rpx solid rgba(5,150,105,0.12);
  background: rgba(240,253,244,0.5);
}
.ds-meta {
  font-size: 22rpx; color: #475569;
}
.ds-odds-label {
  font-size: 22rpx; color: #64748b; margin-bottom: 4rpx;
}

/* ── 大小球 → 标准平赔 横幅 ── */
.ds-ou-banner {
  display: flex;
  align-items: center;
  background: linear-gradient(90deg, #f1f5fd 0%, #eef2ff 100%);
  border: 1rpx solid #c7d2fe;
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  margin-bottom: 16rpx;
}
.ds-ou-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.ds-ou-label {
  font-size: 20rpx;
  color: #94a3b8;
  margin-bottom: 4rpx;
}
.ds-ou-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #1e293b;
}
.ds-ou-value.ds-value-purple {
  color: #7c3aed;
}
.ds-ou-value.ds-std-draw {
  color: #0f766e;
  font-size: 32rpx;
}
.ds-ou-arrow {
  font-size: 28rpx;
  color: #94a3b8;
  margin: 0 8rpx;
  margin-top: 12rpx;
}
.ds-ou-reference {
  margin: 0 0 16rpx;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
}
.ds-ou-reference-label {
  display: block;
  margin-bottom: 6rpx;
  font-size: 20rpx;
  color: #64748b;
}
.ds-ou-reference-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #334155;
}
.ds-ou-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.ds-ou-snapshot {
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
}
.ds-ou-snapshot-label {
  display: block;
  margin-bottom: 6rpx;
  font-size: 20rpx;
  color: #64748b;
}
.ds-ou-snapshot-value {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: #1e293b;
}
.ds-ou-snapshot-water {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #475569;
}
.ds-ou-snapshot-meta {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #7c3aed;
}
.ds-node-ou {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
  margin: 10rpx 0 6rpx;
  padding: 10rpx 12rpx;
  border-radius: 10rpx;
  background: rgba(124,58,237,0.05);
  border: 1rpx solid rgba(124,58,237,0.10);
}
.ds-node-ou-label {
  font-size: 20rpx;
  color: #64748b;
}
.ds-node-ou-value {
  font-size: 22rpx;
  font-weight: 600;
  color: #1e293b;
}
.ds-node-ou-tag {
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: #ede9fe;
  color: #6d28d9;
  font-size: 20rpx;
  font-weight: 700;
}

/* ── 各阶段水位标注行 ── */
.ds-water-row {
  display: flex;
  align-items: center;
  margin: 6rpx 0 4rpx;
  gap: 12rpx;
}
.ds-water-tag {
  font-size: 22rpx;
  font-weight: 700;
  padding: 3rpx 14rpx;
  border-radius: 20rpx;
  background: #e2e8f0;
  color: #475569;
}
.ds-water-tag.water-high {
  background: #fee2e2;
  color: #dc2626;
}
.ds-water-tag.water-low {
  background: #dcfce7;
  color: #16a34a;
}
.ds-water-tag.water-mid {
  background: #e0f2fe;
  color: #0369a1;
}
.ds-water-zone {
  font-size: 20rpx;
  color: #94a3b8;
  flex: 1;
}
.ds-water-std-wrap {
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.ds-water-std-label {
  font-size: 20rpx;
  color: #94a3b8;
}
.ds-water-std-val {
  font-size: 26rpx;
  font-weight: 700;
  color: #0f766e;
}
