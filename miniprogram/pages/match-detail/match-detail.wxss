/* 合理开盘区间表格 */
.reasonable-odds-table {
  display: flex;
  flex-direction: column;
  border: 1rpx solid #E5E7EB;
  border-radius: 8rpx;
  overflow: hidden;
}

.reasonable-odds-header {
  display: grid;
  grid-template-columns: 1.5fr 2fr 1.5fr 1.5fr;
  gap: 8rpx;
  padding: 14rpx 12rpx;
  background: #1F2937;
  font-weight: 600;
  font-size: 20rpx;
  color: #FFFFFF;
}

.reasonable-odds-row {
  display: grid;
  grid-template-columns: 1.5fr 2fr 1.5fr 1.5fr;
  gap: 8rpx;
  padding: 14rpx 12rpx;
