  gap: 12rpx;
  background: #FFF7ED;
  border-radius: 16rpx;
  padding: 16rpx;
  margin: 12rpx 0 16rpx;
}

.feature-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  background: #ffffff;
  border: 1rpx solid #FDE68A;
