/* pages/match-detail/match-detail.wxss */

/* ========== 优化后的设计系统 ========== */
.match-detail-page {
  min-height: 100vh;
  background: #F5F6F8;
}

/* 加载状态 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #E5E7EB;
  border-top-color: #E8590C;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  color: #6B7280;
  font-size: 28rpx;
}

/* 详情内容 */
.detail-content {
  padding-bottom: calc(var(--spacing-3xl) + env(safe-area-inset-bottom));
}

/* 比赛头部 - 深色质感 */
.match-header {
  background: linear-gradient(145deg, #1A2942 0%, #0F1C2E 100%);
  padding: 48rpx 30rpx 60rpx;
  color: #FFFFFF;
  position: relative;
}

.league-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.league-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #E8590C;
  background: rgba(232, 89, 12, 0.15);
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
}

.league-round {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

.match-status-badge {
  position: absolute;
  top: 40rpx;
  right: 30rpx;
  padding: 8rpx 20rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  font-weight: 500;
  background: rgba(255, 255, 255, 0.1);
}

/* 比赛对阵 */
.match-teams {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-top: 20rpx;
}

.team-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.team-logo {
  width: 100rpx;
  height: 100rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: bold;
  color: #FFFFFF;
  border: 2rpx solid rgba(255, 255, 255, 0.2);
}

.team-logo.home {
  background: linear-gradient(135deg, #E8590C 0%, #D64800 100%);
}

.team-logo.away {
  background: linear-gradient(135deg, #3B82F6 0%, #1D4ED8 100%);
}

.team-name {
  font-size: 24rpx;
  font-weight: 500;
  text-align: center;
  max-width: 180rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: rgba(255, 255, 255, 0.9);
}

/* 排名胶囊 */
.rank-pill {
  padding: 4rpx 12rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 4rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.rank-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.7);
  font-weight: 500;
}

/* 比分 - 大而醒目 */
.score {
  font-size: 64rpx;
  font-weight: 800;
  font-family: 'DIN Condensed', 'Impact', 'Arial Black', sans-serif;
  color: #FFFFFF;
  line-height: 1;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
}

.score-pill {
  background: transparent;
  padding: 0;
  min-width: auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.match-center {
  flex: 0 0 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 8rpx;
  padding-top: 20rpx;
}

.status-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #10B981;
  background: rgba(16, 185, 129, 0.15);
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.start-time {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
}

.vs-text {
  font-size: 28rpx;
  font-weight: 800;
  color: rgba(255, 255, 255, 0.3);
}

/* 基本面洞察 */
.fundamental-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.fundamental-list-item {
  background: #F9FAFB;
  border-radius: 8rpx;
  padding: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  border: 1rpx solid #E5E7EB;
}

.fundamental-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.fundamental-badge {
  min-width: 80rpx;
  padding: 6rpx 14rpx;
  border-radius: 4rpx;
  background: #1F2937;
  color: #fff;
  font-weight: 600;
  text-align: center;
  font-size: 22rpx;
}

.fundamental-score {
  font-size: 32rpx;
  font-weight: 800;
  color: #E8590C;
  font-family: 'DIN Condensed', 'Impact', sans-serif;
}

.fundamental-confidence {
  font-size: 22rpx;
  color: #059669;
  font-weight: 500;
}
.poisson-status-badge {
  font-size: 18rpx;
  font-weight: 600;
  color: #059669;
  background: #D1FAE5;
  padding: 4rpx 10rpx;
  border-radius: 4rpx;
  margin-left: 12rpx;
}

.poisson-stats {
  display: flex;
  justify-content: space-around;
  padding: 16rpx 0;
  background: #F9FAFB;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.poisson-stat {
  font-size: 24rpx;
  font-weight: 600;
  color: #374151;
  text-align: center;
}
.poisson-placeholder {
  text-align: center;
  padding: 40rpx 0;
  color: var(--text-secondary);
}
.placeholder-text {
  font-size: 26rpx;
}
.poisson-error {
  text-align: center;
  padding: 40rpx 0;
}
.error-text {
  font-size: 26rpx;
  color: #ff4d4f;
}
.load-btn,
.retry-btn {
  margin-top: 16rpx;
}
/* 积分榜 */
.standings-container {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.standing-item {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.standing-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.team-name-small {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.standing-position {
  font-size: 24rpx;
  color: var(--primary-color);
  font-weight: 600;
  padding: 4rpx 12rpx;
  background: rgba(255, 107, 53, 0.1);
  border-radius: 12rpx;
}

.standing-stats {
  display: flex;
  justify-content: space-around;
  gap: 10rpx;
}

.stat-box {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx;
  background: var(--bg-secondary);
  border-radius: 12rpx;
}

.stat-value {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--primary-color);
  font-family: 'DIN Alternate', 'Arial', sans-serif;
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.standing-divider {
  height: 1rpx;
  background: var(--border-color);
  margin: 10rpx 0;
}

/* 推荐分析 */
.recommendation-box {
  padding: 30rpx;
  background: linear-gradient(135deg, rgba(255, 107, 53, 0.1), rgba(247, 183, 49, 0.1));
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.rec-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.rec-label {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.rec-outcome {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--primary-color);
}

.rec-confidence {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.confidence-label {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.confidence-value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--accent-color);
}

/* 分析详情 */
.analysis-details {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.analysis-item {
  padding: 20rpx;
  background: var(--bg-secondary);
  border-radius: 12rpx;
  border-left: 4rpx solid var(--primary-color);
}

.analysis-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.analysis-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.analysis-score {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--primary-color);
  font-family: 'DIN Alternate', 'Arial', sans-serif;
}

.analysis-meta {
  display: flex;
  gap: 20rpx;
}

.meta-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 赔率分析表格 */
.odds-table {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.odds-company-item {
  padding: 24rpx;
  background: var(--bg-secondary);
  border-radius: 12rpx;
  border-left: 4rpx solid var(--primary-color);
}

.company-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.company-name {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.company-recommendation {
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.company-recommendation.home {
  background: var(--primary-color);
}

.company-recommendation.draw {
  background: var(--accent-color);
}

.company-recommendation.away {
  background: var(--secondary-color);
}

.odds-comparison {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.odds-section {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.odds-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 600;
}

.odds-row {
  display: flex;
  justify-content: space-around;
  gap: 10rpx;
}

.odds-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 10rpx;
  background: var(--bg-primary);
  border-radius: 8rpx;
}

.odds-title {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.odds-value {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-primary);
  font-family: 'DIN Alternate', 'Arial', sans-serif;
}

.odds-value.highlight {
  color: var(--primary-color);
}

.odds-value-pill {
  margin: 8rpx auto;
  padding: 10rpx 12rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid #ececec;
  min-width: 90rpx;
}

.odds-range {
  font-size: 20rpx;
  color: var(--accent-color);
  font-weight: 500;
}

.team-strength {
  display: flex;
  justify-content: space-around;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border-color);
}

.strength-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
}

.strength-label {
  color: var(--text-secondary);
}

.strength-value {
  color: var(--primary-color);
  font-weight: 600;
}

.strength-tier {
  color: var(--accent-color);
  font-size: 20rpx;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 16rpx;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  transition: all 0.2s ease;
}

.btn-primary {
  background: #E8590C;
  color: #FFFFFF;
  box-shadow: 0 6rpx 20rpx rgba(232, 89, 12, 0.3);
}

.btn-secondary {
  background: #FFFFFF;
  color: #374151;
  border: 2rpx solid #D1D5DB;
}

.action-btn:active {
  transform: scale(0.97);
}

.btn-primary:active {
  background: #D64800;
}

.btn-secondary:active {
  background: #F3F4F6;
}

.quick-control {
  padding: 20rpx 30rpx;
}

.quick-toggle {
  width: 100%;
  height: 72rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, var(--primary-color), #ff7a3e);
  color: white;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 16rpx rgba(255, 107, 53, 0.35);
}

.rule-panel {
  margin: 0 20rpx 20rpx;
}

.quick-card {
  border-radius: 18rpx;
  border-width: 3rpx;
  border-style: solid;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.quick-icon {
  font-size: 42rpx;
}

.quick-content {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.quick-title {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.quick-outcome {
  font-size: 32rpx;
  font-weight: 700;
}

.quick-level {
  font-size: 20rpx;
  color: var(--text-secondary);
}

.quick-label {
  font-size: 18rpx;
  color: var(--text-secondary);
}

.rule-row {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.rule-block {
  padding: 20rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.07);
}

.rule-block-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-secondary);
  margin-bottom: 6rpx;
}

.rule-status {
  align-self: flex-start;
  border-radius: 12rpx;
  padding: 6rpx 14rpx;
  color: white;
  font-size: 22rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.rule-zone-label {
  font-size: 20rpx;
  color: var(--text-secondary);
}

.rule-zone {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.rule-desc {
  font-size: 20rpx;
  color: var(--text-secondary);
}

.rule-details {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 6rpx 18rpx rgba(0,0,0,0.05);
}

.detail-header {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.detail-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.detail-item {
  flex: 1;
  min-width: 160rpx;
  padding: 10rpx;
  background: #f3f4f6;
  border-radius: 10rpx;
}

.detail-label {
  font-size: 18rpx;
  color: #6b7280;
}

.detail-value {
  font-size: 22rpx;
  font-weight: 600;
  color: #1f2937;
}

.rule-error,
.rule-loading {
  padding: 30rpx;
  border-radius: 16rpx;
  background: #fff5f5;
  color: #b91c1c;
  font-size: 24rpx;
  text-align: center;
}

.odds-table-container {
  margin: 0;
  border-radius: 12rpx;
  background: #F9FAFB;
  overflow: hidden;
  border: 1rpx solid #E5E7EB;
}

.table-head,
.table-row {
  display: grid;
  grid-template-columns: repeat(11, minmax(0, 1fr));
  padding: 14rpx 12rpx;
  align-items: center;
  font-size: 20rpx;
  color: #4B5563;
}

.table-head {
  background: #1F2937;
  color: #FFFFFF;
  font-weight: 600;
  font-size: 18rpx;
}

.table-row {
  border-bottom: 1rpx solid #E5E7EB;
  background: #FFFFFF;
}

.table-row:nth-child(odd) {
  background: #F9FAFB;
}

.table-row:last-child {
  border-bottom: none;
}

.table-cell {
  text-align: center;
  word-break: break-word;
}

.pagination-bar {
  margin: 16rpx 0 0;
  padding: 16rpx 20rpx;
  border-radius: 8rpx;
  background: #F9FAFB;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  border: 1rpx solid #E5E7EB;
}

.pagination-text {
  font-size: 22rpx;
  color: #6B7280;
}

.pagination-btn {
  min-width: 180rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 8rpx;
  background: #1F2937;
  color: #ffffff;
  font-size: 24rpx;
  border: none;
  font-weight: 500;
}

.pagination-btn[disabled] {
  background: #D1D5DB;
  color: #9CA3AF;
}

.type-cell {
  font-weight: 600;
  color: #1d4ed8;
}

.recommendation {
  font-weight: 600;
  color: #ec4899;
}

.poisson-action {
  padding: 0 20rpx 20rpx;
}

.poisson-view {
  width: 100%;
  height: 72rpx;
  border-radius: 8rpx;
  background: #1F2937;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  border: none;
}

.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.75);
  display: flex;
  justify-content: center;
  align-items: flex-end;
  z-index: 9999;
  padding: 0;
}

.modal-card {
  width: 100%;
  max-height: 85%;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.modal-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #E5E7EB;
}

.modal-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1F2937;
}

.modal-close {
  border: none;
  background: #F3F4F6;
  color: #6B7280;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 6rpx;
}

.modal-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  overflow: hidden;
}

.modal-row {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #0f172a;
  flex-wrap: wrap;
  gap: 8rpx;
}

.modal-subtitle {
  font-size: 24rpx;
  font-weight: 600;
  color: #2563eb;
  margin-top: 6rpx;
}

.ou-list {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.ou-item {
  flex: 1;
  min-width: 150rpx;
  padding: 12rpx;
  background: #f8fafc;
  border-radius: 10rpx;
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
}

.ou-empty {
  font-size: 22rpx;
  color: #9ca3af;
}

.score-table {
  flex: 1;
  overflow-y: auto;
  margin-top: 6rpx;
}

.score-row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  border-bottom: 1px solid #e2e8f0;
  font-size: 22rpx;
}

.recommendation-badge {
  margin-top: 20rpx;
  align-self: flex-start;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.2);
  font-size: 22rpx;
  font-weight: 600;
}

/* ========== 通用卡片样式 ========== */
.info-card, .fundamental-card, .poisson-card, .reasonable-odds-card, .attitude-card, .rule-match-card {
  margin: 20rpx 24rpx;
  padding: 28rpx;
  border-radius: 4rpx 16rpx 16rpx 4rpx;
  background: #FFFFFF;
  border-left: 6rpx solid #E5E7EB;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

/* 赔率分析卡片 - 核心模块，特殊强调 */
.odds-card {
  margin: 24rpx 24rpx;
  padding: 0;
  border-radius: 16rpx;
  background: #FFFFFF;
  border-left: none;
  box-shadow: 0 8rpx 32rpx rgba(232, 89, 12, 0.12);
  border: 2rpx solid #E8590C;
  overflow: hidden;
}

.odds-card > .card-title {
  background: linear-gradient(135deg, #E8590C 0%, #D64800 100%);
  color: #FFFFFF;
  margin: 0;
  padding: 24rpx 28rpx;
  border-radius: 0;
}

.odds-card > .card-title .module-toggle {
  color: rgba(255, 255, 255, 0.8);
}

.odds-card > view:not(.card-title) {
  padding: 24rpx 28rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1F2937;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
