/* pages/matches/matches.wxss */
/* ========== 页面容器 ========== */
.matches-page {
  min-height: 100vh;
  background: var(--bg-secondary);
  padding-bottom: calc(var(--spacing-3xl) + env(safe-area-inset-bottom));
}

/* ========== 搜索栏 ========== */
.search-bar {
  padding: var(--spacing-lg) var(--spacing-2xl);
  background: var(--bg-primary);
  box-shadow: var(--shadow-sm);
}

.search-input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
}

.search-input {
  flex: 1;
  height: 70rpx;
  padding: 0 50rpx 0 var(--spacing-2xl);
  background: var(--bg-secondary);
  border-radius: var(--radius-full);
  font-size: var(--font-base);
  color: var(--text-primary);
}

.search-icon {
  position: absolute;
  right: var(--spacing-2xl);
  font-size: var(--font-xl);
  opacity: 0.5;
}

/* ========== 筛选面板 ========== */
.filter-panel {
  background: var(--bg-primary);
  border-bottom: 1rpx solid var(--border-color);
  overflow: hidden;
}

.filter-header {
  padding: var(--spacing-lg) var(--spacing-2xl);
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid var(--border-color);
}

.filter-title {
  font-size: var(--font-base);
  font-weight: var(--font-weight-semibold);
  color: var(--text-primary);
}

.filter-content {
  padding: var(--spacing-lg) var(--spacing-2xl);
}

.module-toggle {
  font-size: 24rpx;
  color: var(--text-tertiary);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  padding: 10rpx;
}

.module-toggle.expanded {
  transform: rotate(180deg);
  color: var(--primary-color);
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
  align-items: center;
  margin-bottom: var(--spacing-xs);
}

.filter-chip {
  padding: var(--spacing-xs) var(--spacing-lg);
  border-radius: 18rpx;
  background: var(--bg-secondary);
  font-size: var(--font-md);
  color: var(--text-primary);
  border: 1rpx solid transparent;
  transition: all var(--transition-base);
}

.filter-chip-group {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-xs);
}

.filter-chip.active {
  border-color: var(--primary-color);
  color: var(--primary-color);
  box-shadow: var(--shadow-primary);
  font-weight: var(--font-weight-semibold);
}

.status-row {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.status-tab {
  padding: var(--spacing-xs) 18rpx;
  border-radius: var(--radius-md);
  background: var(--bg-secondary);
  color: var(--text-secondary);
  border: 1rpx solid transparent;
  transition: all var(--transition-base);
}

.status-tab.active {
  border-color: var(--primary-color);
  color: var(--primary-color);
  font-weight: var(--font-weight-semibold);
  box-shadow: var(--shadow-primary);
}

/* 比赛容器 */
.matches-container {
  padding: var(--spacing-2xl);
}

.signal-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: var(--spacing-xl);
  padding: 14rpx 12rpx;
  background: #ffffff;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.signal-summary-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  min-height: 64rpx;
  border-radius: 14rpx;
  font-size: 22rpx;
  transition: all 0.2s ease;
}

.signal-summary-item:active {
  transform: scale(0.98);
}

.signal-summary-item.active {
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.12);
  transform: translateY(-1rpx);
}

.signal-summary-item.inactive {
  opacity: 0.45;
}

.signal-summary-item.heavy {
  background: #FFF0F0;
  color: #FF3B30;
}

.signal-summary-item.strong {
  background: #FFF8F0;
  color: #FF9500;
}

.signal-summary-item.reference {
  background: #F5F5F5;
  color: #666666;
}

.signal-summary-item.all {
  background: #F0F4FA;
  color: #4A5A6A;
}

.signal-summary-icon {
  font-size: 24rpx;
}

.signal-summary-label {
  font-weight: 600;
}

.signal-summary-count {
  font-weight: 700;
}

/* 比赛列表 */
.matches-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-xl);
}

/* 日期分组 */
.date-group {
  margin-bottom: var(--spacing-lg);
}

.date-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-lg);
  padding: 0 10rpx;
}

.date-text {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-primary);
  line-height: 1.35;
}

.date-count {
  font-size: 22rpx;
  color: var(--text-secondary);
  padding: 6rpx 12rpx;
  background: var(--bg-secondary);
  border-radius: 12rpx;
}

.date-matches {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-lg);
}

/* 加载状态 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 150rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--border-color);
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  color: var(--text-secondary);
  font-size: 28rpx;
}

/* Skeleton */
.skeleton-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.skeleton-card {
  background: var(--bg-primary);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  box-shadow: var(--shadow-sm);
}

.skeleton-header {
  height: 24rpx;
  width: 40%;
  background: var(--bg-tertiary);
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  position: relative;
  overflow: hidden;
}

.skeleton-body {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.skeleton-team {
  flex: 1;
  height: 80rpx;
  background: var(--bg-tertiary);
  border-radius: 16rpx;
  position: relative;
  overflow: hidden;
}

.skeleton-score {
  width: 80rpx;
  height: 60rpx;
  background: var(--bg-tertiary);
  border-radius: 12rpx;
  position: relative;
  overflow: hidden;
}

.skeleton-header::after,
.skeleton-team::after,
.skeleton-score::after {
  content: "";
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.6), transparent);
  animation: shimmer 1.2s infinite;
}

@keyframes shimmer {
  0% { transform: translateX(0); }
  100% { transform: translateX(200%); }
}

/* Load more */
.load-more {
  display: flex;
  justify-content: center;
  margin-top: 20rpx;
}

.load-more-btn {
  min-width: 220rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: var(--bg-primary);
  color: var(--text-primary);
  border: 2rpx solid var(--border-color);
  font-size: 26rpx;
  font-weight: 500;
}

.load-more-btn[disabled] {
  opacity: 0.6;
}

.load-more-tip {
  text-align: center;
  color: var(--text-secondary);
  font-size: 24rpx;
  margin-top: 20rpx;
}

/* ========== 状态筛选栏 ========== */
.status-bar {
  display: flex;
  gap: 12rpx;
  padding: var(--spacing-sm) var(--spacing-2xl);
  background: var(--bg-primary);
  border-bottom: 1rpx solid var(--border-color);
}

/* ========== 快捷联赛筛选 ========== */
.league-quick-bar {
  background: linear-gradient(135deg, #1A2942 0%, #0F1C2E 100%);
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(255,255,255,0.1);
}

.league-scroll {
  white-space: nowrap;
}

.league-chips {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 var(--spacing-2xl);
}

.league-chips-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.5);
  flex-shrink: 0;
}

.league-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255,255,255,0.25);
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
  background: rgba(255,255,255,0.06);
  white-space: nowrap;
  transition: all 0.2s ease;
}

.league-chip:active {
  transform: scale(0.96);
}

.league-chip.active {
  border-color: #2ecc71;
  color: #2ecc71;
  background: rgba(46,204,113,0.15);
  font-weight: 600;
}

.clear-chip {
  border-color: rgba(255,107,53,0.5);
  color: #ff6b35;
  background: rgba(255,107,53,0.1);
}
