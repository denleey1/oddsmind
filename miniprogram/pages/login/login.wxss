/* pages/login/login.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(145deg, #0f355f 0%, #1f5b94 45%, #ff7a3e 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-2xl);
  padding-bottom: calc(var(--spacing-2xl) + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.loading-container {
  text-align: center;
  color: #ffffff;
}

.loading-icon {
  font-size: 72rpx;
  margin-bottom: var(--spacing-md);
}

.loading-text {
  font-size: 30rpx;
  margin-top: var(--spacing-xl);
  line-height: 1.4;
}

.activate-container {
  width: 100%;
  max-width: 620rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
  text-align: center;
  line-height: 1.25;
  margin-bottom: 14rpx;
}

.subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  text-align: center;
  line-height: 1.45;
  margin-bottom: 44rpx;
}

.form-container {
  background: #ffffff;
  border-radius: var(--radius-xl);
  padding: 44rpx 30rpx 36rpx;
  box-shadow: 0 20rpx 56rpx rgba(8, 25, 46, 0.28);
}

.input-group {
  margin-bottom: var(--spacing-xl);
}

.input {
  width: 100%;
  height: 84rpx;
  border: 2rpx solid #dfe5ee;
  border-radius: var(--radius-md);
  padding: 0 24rpx;
  font-size: 30rpx;
  line-height: 84rpx;
  box-sizing: border-box;
  background: #fbfcff;
}

.input:focus {
  border-color: #2f74b5;
  background: #ffffff;
}

.error-message {
  color: #c0392b;
  font-size: 24rpx;
  line-height: 1.55;
  margin: var(--spacing-md) 0;
  padding: 14rpx 16rpx;
  background: #fff4f3;
  border: 1rpx solid #ffd8d2;
  border-radius: var(--radius-md);
  text-align: left;
  white-space: pre-line;
}

.submit-btn {
  width: 100%;
  height: 84rpx;
  background: linear-gradient(135deg, #1f5b94 0%, #2f74b5 45%, #ff7a3e 100%);
  color: #ffffff;
  border-radius: var(--radius-md);
  font-size: 28rpx;
  font-weight: 700;
  border: none;
  margin-top: var(--spacing-sm);
  margin-bottom: var(--spacing-md);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 28rpx rgba(31, 91, 148, 0.28);
}

.submit-btn[disabled] {
  opacity: 0.62;
}

.retry-link {
  text-align: center;
  color: #2f74b5;
  font-size: 24rpx;
  line-height: 1.3;
  min-height: 64rpx;
  padding: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.error-container {
  text-align: center;
  color: #ffffff;
  width: 100%;
  max-width: 620rpx;
}

.error-icon {
  font-size: 104rpx;
  margin-bottom: var(--spacing-lg);
}

.error-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: var(--spacing-md);
}

.retry-btn {
  margin-top: 44rpx;
  width: 320rpx;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.16);
  color: #ffffff;
  border-radius: var(--radius-md);
  font-size: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.35);
}

.retry-btn[disabled] {
  opacity: 0.6;
}

/* 获取激活码区域 */
.purchase-section {
  margin-top: 40rpx;
  padding-top: 10rpx;
}

.purchase-divider {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: #e0e0e0;
}

.divider-text {
  padding: 0 20rpx;
  font-size: 24rpx;
  color: #999;
}

.purchase-hint {
  text-align: center;
  font-size: 26rpx;
  color: #888;
  margin-bottom: 20rpx;
}

.purchase-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #ff6b35 0%, #ff4444 100%);
  color: #fff;
  border-radius: 10rpx;
  font-size: 30rpx;
  font-weight: bold;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.purchase-btn:active {
  opacity: 0.85;
}

/* 错误页面中的获取链接 */
.error-purchase-link {
  margin-top: 40rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  text-decoration: underline;
  padding: 16rpx;
}

/* 产品说明链接 */
.guide-link {
  text-align: center;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 24rpx;
  padding: 12rpx;
  text-decoration: underline;
}
