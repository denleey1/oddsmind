.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 56rpx 28rpx;
  background: var(--bg-primary);
  border-radius: var(--radius-lg);
  border: 1rpx solid var(--border-light);
  text-align: center;
}

.empty-state.compact {
  padding: 44rpx 24rpx;
}

.empty-icon {
  font-size: 70rpx;
  line-height: 1;
  margin-bottom: 16rpx;
  opacity: 0.75;
}

.empty-title {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: var(--font-weight-semibold);
  line-height: 1.45;
}

.empty-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.empty-action {
  margin-top: 18rpx;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: var(--primary-color);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: var(--font-weight-medium);
}

.empty-action:active {
  opacity: 0.88;
  transform: scale(0.98);
}
