# ============================================
# MySQL性能优化配置
# 目标：将查询时间优化到2秒以内
# 使用方法：将此配置添加到my.cnf或my.ini中
# ============================================

[mysqld]
# ============================================
# InnoDB缓冲区配置（最重要的配置）
# ============================================
# InnoDB缓冲池大小，建议设置为系统内存的50-70%
# 对于16GB内存的服务器，设置为8GB
innodb_buffer_pool_size = 8G

# 缓冲池实例数，设置为CPU核心数或缓冲池大小/1GB
innodb_buffer_pool_instances = 8

# 每个实例的块大小
innodb_buffer_pool_chunk_size = 128M

# ============================================
# InnoDB日志配置
# ============================================
# InnoDB日志文件大小，增大可以提高写入性能
innodb_log_file_size = 512M

# 日志缓冲区大小
innodb_log_buffer_size = 16M

# 刷新日志到磁盘的策略：1=每次事务提交，2=每秒，0=不刷新
# 为了性能和安全的平衡，建议设置为2
innodb_flush_log_at_trx_commit = 2

# 刷新方法：O_DIRECT避免双重缓冲
innodb_flush_method = O_DIRECT

# ============================================
# InnoDB IO配置
# ============================================
# InnoDB I/O线程数
innodb_read_io_threads = 8
innodb_write_io_threads = 8

# 最大并发线程数
innodb_thread_concurrency = 16

# 旧数据最大存储时间（用于purge线程）
innodb_max_purge_lag = 100000

# ============================================
# 查询缓存配置
# ============================================
# 查询缓存大小（0=禁用）
# 注意：MySQL 8.0已移除查询缓存，如果是8.0+版本忽略此项
# query_cache_size = 64M
# query_cache_type = 1

# ============================================
# 连接和线程配置
# ============================================
# 最大连接数
max_connections = 200

# 线程缓存大小
thread_cache_size = 16

# 临时表大小（内存中的临时表）
tmp_table_size = 64M
max_heap_table_size = 64M

# ============================================
# 表和索引配置
# ============================================
# 表定义缓存（存储表结构信息）
table_open_cache = 2000

# 打开的文件描述符限制
open_files_limit = 65535

# MyISAM排序缓冲区（用于ORDER BY和GROUP BY）
sort_buffer_size = 2M
read_buffer_size = 1M
read_rnd_buffer_size = 2M

# ============================================
# 慢查询日志配置
# ============================================
# 慢查询阈值（秒）
long_query_time = 2

# 记录慢查询
slow_query_log = 1

# 慢查询日志路径
slow_query_log_file = /var/log/mysql/slow-query.log

# ============================================
# 二进制日志配置
# ============================================
# 二进制日志过期天数
expire_logs_days = 7

# 二进制日志格式
binlog_format = ROW

# ============================================
# 其他优化配置
# ============================================
# 跳过DNS反向解析（加速连接）
skip_name_resolve = 1

# 字符集
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# 连接超时
wait_timeout = 28800
interactive_timeout = 28800

# 锁等待超时（秒）
innodb_lock_wait_timeout = 50

# ============================================
# 性能监控配置（可选）
# ============================================
# 启用性能模式
performance_schema = ON

# 性能模式内存大小
performance_schema_events_waits_history_size = 100
performance_schema_events_stages_history_size = 100
performance_schema_events_statements_history_size = 100













